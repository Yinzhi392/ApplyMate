page {
  --color-background: #f5f6f2;
  --color-surface: #ffffff;
  --color-surface-muted: #eef2ee;
  --color-text: #18313b;
  --color-text-secondary: #5d6d72;
  --color-primary: #2f756c;
  --color-primary-strong: #245d56;
  --color-primary-soft: #e2eeea;
  --color-border: #dce2de;
  --color-warning: #8a571f;
  --color-warning-soft: #fff2df;
  --color-danger: #923d35;
  --color-danger-soft: #faeae7;
  min-height: 100%;
  background: var(--color-background);
  color: var(--color-text);
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.55;
}

view,
button,
input,
textarea,
picker {
  box-sizing: border-box;
}

button,
input,
textarea {
  font: inherit;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 40rpx 32rpx calc(56rpx + env(safe-area-inset-bottom));
}

.page-header {
  margin-bottom: 48rpx;
}

.title {
  color: var(--color-text);
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.22;
}

.subtitle {
  max-width: 640rpx;
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 28rpx;
  line-height: 1.65;
}

.section-title {
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 650;
  line-height: 1.35;
}

.field-label {
  display: block;
  margin-bottom: 14rpx;
  color: var(--color-text);
  font-size: 27rpx;
  font-weight: 600;
}

.muted,
.safe-note,
.privacy-note,
.sr-summary {
  color: var(--color-text-secondary);
}

.muted {
  font-size: 27rpx;
  line-height: 1.65;
}

.safe-note,
.privacy-note,
.sr-summary {
  font-size: 24rpx;
  line-height: 1.65;
}

.row,
.row-between,
.actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.row-between {
  justify-content: space-between;
}

.actions {
  flex-wrap: wrap;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.surface,
.form-section,
.list-surface,
.action-panel {
  background: var(--color-surface);
}

.surface,
.form-section,
.action-panel {
  padding: 28rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx;
}

.list-surface {
  overflow: hidden;
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx;
}

.list-item {
  min-height: 104rpx;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.list-item:last-child {
  border-bottom: 0;
}

.button {
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 18rpx 28rpx;
  border: 0;
  border-radius: 16rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 52rpx;
}

.button-secondary {
  border: 2rpx solid var(--color-border);
  background: var(--color-surface);
  color: var(--color-text);
}

.button-quiet {
  width: auto;
  min-width: 88rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary-strong);
}

.button-danger {
  background: var(--color-danger);
}

.button-danger-secondary {
  border: 2rpx solid #ddc3bf;
  background: var(--color-surface);
  color: var(--color-danger);
}

.button[disabled] {
  border-color: transparent;
  background: #d9dedb;
  color: #7d898d;
}

.text-action {
  display: inline-flex;
  align-items: center;
  width: auto;
  min-height: 88rpx;
  margin: 0;
  padding: 0 8rpx;
  background: transparent;
  color: var(--color-primary);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
}

.input,
.textarea,
.select-field {
  width: 100%;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  background: var(--color-surface);
  color: var(--color-text);
}

.input,
.select-field {
  min-height: 88rpx;
  padding: 18rpx 22rpx;
}

.textarea {
  min-height: 260rpx;
  padding: 22rpx;
  line-height: 1.65;
}

.textarea-placeholder,
input::placeholder,
textarea::placeholder {
  color: #899496;
}

.select-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.select-hint {
  color: var(--color-primary);
  font-size: 25rpx;
}

.pill,
.count-label {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary-strong);
  font-size: 24rpx;
  line-height: 1.4;
}

.pill-warn {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.status,
.error,
.warning,
.empty {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
  line-height: 1.6;
}

.status {
  background: var(--color-primary-soft);
  color: var(--color-primary-strong);
}

.warning {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.error {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.empty {
  border: 2rpx dashed #cdd5d1;
  color: var(--color-text-secondary);
  text-align: center;
}

.message-title {
  margin-bottom: 4rpx;
  font-weight: 650;
}

.counter {
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  text-align: right;
}

.divider {
  height: 1rpx;
  margin: 24rpx 0;
  background: var(--color-border);
}

.sticky-action {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 40rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
