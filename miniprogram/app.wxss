page {
  min-height: 100%;
  background: #f7f6f2;
  color: #18313b;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
}

button,
input,
textarea {
  font: inherit;
}

button::after {
  border: 0;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 40rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.eyebrow {
  color: #2e776e;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.title {
  margin: 12rpx 0 8rpx;
  color: #18313b;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.2;
}

.subtitle,
.muted {
  color: #65747a;
  line-height: 1.7;
}

.section-title {
  margin: 36rpx 0 16rpx;
  color: #18313b;
  font-size: 32rpx;
  font-weight: 650;
}

.card {
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #e5e2da;
  border-radius: 24rpx;
  background: #fffefa;
  box-shadow: 0 12rpx 36rpx rgba(24, 49, 59, 0.06);
}

.card-compact {
  padding: 22rpx 24rpx;
}

.row,
.row-between,
.actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.row-between {
  justify-content: space-between;
}

.actions {
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.button {
  box-sizing: border-box;
  min-height: 88rpx;
  margin: 0;
  padding: 20rpx 32rpx;
  border-radius: 999rpx;
  background: #18313b;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 48rpx;
}

.button-secondary {
  border: 2rpx solid #d6ddd9;
  background: #fffefa;
  color: #18313b;
}

.button-quiet {
  padding-right: 20rpx;
  padding-left: 20rpx;
  background: #edf4f1;
  color: #2e776e;
}

.button-danger {
  background: #9b3c31;
}

.button[disabled] {
  background: #d9ddda;
  color: #879197;
}

.field-label {
  display: block;
  margin: 24rpx 0 10rpx;
  color: #314850;
  font-size: 26rpx;
  font-weight: 600;
}

.input,
.textarea {
  box-sizing: border-box;
  width: 100%;
  border: 2rpx solid #d8dedb;
  border-radius: 16rpx;
  background: #ffffff;
  color: #18313b;
}

.input {
  min-height: 88rpx;
  padding: 18rpx 22rpx;
}

.textarea {
  min-height: 260rpx;
  padding: 22rpx;
  line-height: 1.65;
}

.textarea-result {
  min-height: 480rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 52rpx;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  background: #edf4f1;
  color: #2e776e;
  font-size: 24rpx;
}

.pill-warn {
  background: #fff1e3;
  color: #98551f;
}

.divider {
  height: 1rpx;
  margin: 24rpx 0;
  background: #e5e2da;
}

.status,
.error,
.warning,
.empty {
  box-sizing: border-box;
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  line-height: 1.6;
}

.status {
  background: #edf4f1;
  color: #235f58;
}

.warning {
  background: #fff1e3;
  color: #864b1d;
}

.error {
  background: #faeae7;
  color: #8a3329;
}

.empty {
  border: 2rpx dashed #d8dedb;
  color: #65747a;
  text-align: center;
}

.link {
  color: #2e776e;
  text-decoration: underline;
}

.list-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #ece9e1;
}

.list-item:last-child {
  border-bottom: 0;
}

.counter {
  margin-top: 10rpx;
  color: #65747a;
  font-size: 24rpx;
  text-align: right;
}

.safe-note {
  margin-top: 28rpx;
  color: #65747a;
  font-size: 24rpx;
  line-height: 1.65;
}

.sr-summary {
  margin-top: 12rpx;
  color: #65747a;
  font-size: 24rpx;
}
