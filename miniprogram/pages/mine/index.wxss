.menu-action {
  margin-left: auto;
  min-width: 104rpx;
  flex: 0 0 auto;
  color: var(--color-primary);
  font-size: 25rpx;
  text-align: right;
}

.profile-menu-row {
  display: block;
}

.profile-menu-row-hover {
  opacity: 0.72;
}

.menu-row-content {
  display: flex;
  width: 100%;
  min-width: 0;
  align-items: center;
  gap: 20rpx;
}

.menu-row-content .list-row-main {
  min-width: 0;
  flex: 1 1 0%;
}

.menu-icon {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 72rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 18rpx;
  background: var(--color-primary-soft);
  font-size: 34rpx;
  line-height: 1;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.98), 0 6rpx 16rpx rgba(36, 82, 75, 0.07);
}

.privacy-menu-icon {
  background: #e8efec;
}

.danger-menu-icon {
  background: var(--color-danger-soft);
}

.group-title {
  margin-bottom: 16rpx;
}

.status-row {
  cursor: default;
}

.danger-action {
  min-width: 104rpx;
  margin-left: auto;
  flex: 0 0 auto;
  color: var(--color-danger);
  font-size: 25rpx;
  text-align: right;
}

.danger-row .list-row-main text:first-child {
  color: var(--color-danger);
}
