<view class="page mine-page">
  <view class="page-header">
    <view class="page-header-copy">
      <view class="title">我的 👋</view>
      <view class="subtitle">资料、偏好与数据权利都在这里。</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="status">加载中，正在读取账号信息。</view>
  <view wx:if="{{errorMessage}}" class="error">{{errorMessage}}</view>

  <view class="section">
    <view class="section-title group-title">求职资料</view>
    <view class="list-group">
      <view
        class="list-row profile-menu-row"
        hover-class="profile-menu-row-hover"
        aria-role="button"
        aria-label="简历管理"
        bindtap="openResumes"
      >
        <view class="menu-row-content">
          <view class="menu-icon">📄</view>
          <view class="list-row-main"><text>简历管理</text><text>核对事实、设置默认简历</text></view>
          <view class="menu-action">{{resumeCount}} 份 ›</view>
        </view>
      </view>
      <view
        class="list-row profile-menu-row"
        hover-class="profile-menu-row-hover"
        aria-role="button"
        aria-label="求职偏好"
        bindtap="openPreferences"
      >
        <view class="menu-row-content">
          <view class="menu-icon">🎯</view>
          <view class="list-row-main"><text>求职偏好</text><text>远程、到岗时间等长期补充</text></view>
          <view class="menu-action">编辑 ›</view>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title group-title">使用情况</view>
    <view class="list-group">
      <view class="list-row status-row">
        <view class="list-row-main"><text>今日生成额度</text><text>北京时间每日零点重置</text></view>
        <view class="menu-action">剩余 {{remainingQuota}} 次</view>
      </view>
      <view class="list-row status-row">
        <view class="list-row-main"><text>已确认简历</text><text>最多保存 3 份</text></view>
        <view class="menu-action">{{resumeCount}} / 3</view>
      </view>
      <button wx:if="{{isAdmin}}" class="list-row" bindtap="openAdmin">
        <view class="list-row-main"><text>管理员工具</text><text>受服务端白名单保护</text></view>
        <view class="menu-action">进入 ›</view>
      </button>
    </view>
  </view>

  <view class="section">
    <view class="section-title group-title">隐私与账号</view>
    <view class="list-group">
      <view
        class="list-row profile-menu-row"
        hover-class="profile-menu-row-hover"
        aria-role="button"
        aria-label="协议与隐私"
        bindtap="showAgreements"
      >
        <view class="menu-row-content">
          <view class="menu-icon privacy-menu-icon">🔒</view>
          <view class="list-row-main"><text>协议与隐私</text><text>当前版本 {{agreementVersion}}</text></view>
          <view class="menu-action">查看 ›</view>
        </view>
      </view>
      <view
        class="list-row profile-menu-row danger-row"
        hover-class="profile-menu-row-hover"
        aria-role="button"
        aria-label="删除账号"
        bindtap="deleteAccount"
      >
        <view class="menu-row-content">
          <view class="menu-icon danger-menu-icon">🗑️</view>
          <view class="list-row-main"><text>删除账号</text><text>立即停用，并在 24 小时内删除可关联数据</text></view>
          <view class="danger-action">删除 ›</view>
        </view>
      </view>
    </view>
  </view>
</view>
