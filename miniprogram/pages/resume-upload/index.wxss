.upload-header {
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.mode-switch {
  display: flex;
  width: 100%;
  min-width: 0;
  padding: 6rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 18rpx;
  background: rgba(233, 239, 235, 0.9);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.mode-option {
  width: auto;
  min-width: 0;
  min-height: 88rpx;
  flex: 1 1 0%;
  margin: 0;
  border-radius: 12rpx;
  background: transparent;
  color: var(--color-text-secondary);
  font-size: 26rpx;
}

.mode-option.is-active {
  background: var(--color-glass-surface-strong);
  color: var(--color-primary-strong);
  font-weight: 650;
  box-shadow: inset 0 1rpx 0 #ffffff, 0 6rpx 16rpx rgba(36, 82, 75, 0.08);
}

.upload-content {
  padding: 28rpx;
}

.upload-zone {
  display: flex;
  width: 100%;
  min-height: 280rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 0;
  padding: 28rpx;
  border: 2rpx dashed var(--color-border-strong);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.36);
  color: var(--color-text);
}

.image-upload-row {
  display: flex;
  width: 100%;
  min-height: 104rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 20rpx 0 0;
  padding: 22rpx 4rpx;
  border-bottom: 1rpx solid var(--color-border);
  background: transparent;
  color: var(--color-text);
  text-align: left;
}

.image-upload-copy {
  min-width: 0;
  flex: 1;
}

.select-hint {
  flex-shrink: 0;
  color: var(--color-primary);
  font-size: 24rpx;
}

.upload-symbol {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 42rpx;
}

.upload-title {
  font-weight: 650;
}

.selected-file {
  margin-top: 20rpx;
  padding: 22rpx 4rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.resume-textarea {
  min-height: 430rpx;
}
