<view class="page">
  <view class="title">添加简历</view>
  <view class="subtitle">原文件只用于解析。确认结构化内容后，原文件应从临时存储删除。</view>

  <view class="card">
    <view class="section-title">选择输入方式</view>
    <radio-group class="stack" bindchange="changeInputType">
      <label class="row"><radio value="pdf" checked="{{inputType === 'pdf'}}" color="#2e776e" />PDF 文件</label>
      <label class="row"><radio value="docx" checked="{{inputType === 'docx'}}" color="#2e776e" />DOCX 文件</label>
      <label class="row"><radio value="images" checked="{{inputType === 'images'}}" color="#2e776e" />简历图片</label>
      <label class="row"><radio value="text" checked="{{inputType === 'text'}}" color="#2e776e" />粘贴文字</label>
    </radio-group>
  </view>

  <view class="card">
    <view wx:if="{{inputType === 'pdf' || inputType === 'docx'}}">
      <view class="section-title">选择 {{inputType === 'pdf' ? 'PDF' : 'DOCX'}}</view>
      <view class="muted">单个文件不超过 10MB。旧版 DOC 需先另存为 DOCX。</view>
      <button class="button button-secondary" bindtap="chooseDocument">选择文件</button>
      <view wx:if="{{selectedName}}" class="status">已选择：{{selectedName}}</view>
    </view>

    <view wx:if="{{inputType === 'images'}}">
      <view class="section-title">选择图片</view>
      <view class="muted">最多 6 张，总大小不超过 10MB。请按阅读顺序选择。</view>
      <button class="button button-secondary" bindtap="chooseImages">选择简历图片</button>
      <view wx:if="{{images.length}}" class="status">已选择 {{images.length}} 张</view>
    </view>

    <view wx:if="{{inputType === 'text'}}">
      <label class="field-label" for="resume-text">简历文字</label>
      <textarea id="resume-text" class="textarea" value="{{text}}" maxlength="12000" placeholder="粘贴教育、经历、项目和技能等真实信息" bindinput="updateText" />
      <view class="counter">{{text.length}} / 12000</view>
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="error">{{errorMessage}}</view>
  <view wx:if="{{loading}}" class="status">加载中，正在创建解析任务。</view>
  <button class="button" disabled="{{loading}}" bindtap="submit">开始解析</button>
  <button wx:if="{{errorMessage}}" class="button button-secondary" bindtap="submit">重新尝试</button>
</view>
