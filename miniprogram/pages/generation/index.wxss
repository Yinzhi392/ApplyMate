.generation-header {
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.mode-switch {
  display: flex;
  width: 100%;
  min-width: 0;
  padding: 6rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 18rpx;
  background: rgba(233, 239, 235, 0.9);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.mode-option {
  width: auto;
  min-width: 0;
  min-height: 88rpx;
  flex: 1 1 0%;
  margin: 0;
  border-radius: 12rpx;
  background: transparent;
  color: var(--color-text-secondary);
  font-size: 26rpx;
}

.mode-option.is-active {
  background: var(--color-glass-surface-strong);
  color: var(--color-primary-strong);
  font-weight: 650;
  box-shadow: inset 0 1rpx 0 #ffffff, 0 6rpx 16rpx rgba(36, 82, 75, 0.08);
}

.input-workspace,
.resume-selector {
  padding: 28rpx;
}

.screenshot-list {
  border-top: 1rpx solid var(--color-border);
}

.screenshot-item {
  position: relative;
  display: flex;
  min-height: 128rpx;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.screenshot-item:last-child {
  border-bottom: 0;
}

.screenshot-item.is-dragging {
  opacity: 0.58;
}

.screenshot-item.is-target {
  border-radius: 14rpx;
  background: var(--color-primary-soft);
}

.image-order {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 42rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-primary-soft);
  color: var(--color-primary-strong);
  font-size: 22rpx;
  font-weight: 700;
}

.screenshot-thumb {
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 10rpx;
  background: var(--color-surface);
}

.screenshot-meta {
  min-width: 0;
  flex: 1;
}

.screenshot-name {
  font-weight: 650;
}

.icon-action {
  width: auto;
  min-width: 88rpx;
  max-width: 100%;
  min-height: 88rpx;
  flex: 0 1 auto;
  margin: 0;
  padding: 8rpx 12rpx;
  border-radius: 14rpx;
  background: rgba(247, 230, 227, 0.54);
  color: var(--color-danger);
  font-size: 23rpx;
}

.upload-area {
  display: flex;
  width: 100%;
  min-height: 164rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  margin: 20rpx 0 0;
  padding: 22rpx;
  border: 2rpx dashed var(--color-border-strong);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.36);
  color: var(--color-text);
}

.upload-mark {
  color: var(--color-primary);
  font-size: 42rpx;
}

.upload-copy {
  font-weight: 650;
}

.privacy-note {
  margin-top: 16rpx;
}

.jd-textarea {
  min-height: 430rpx;
  background: var(--color-surface);
}

.select-hint {
  color: var(--color-primary);
  font-size: 24rpx;
}
