.home-page {
  position: relative;
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  overflow: hidden;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.home-glow {
  position: absolute;
  z-index: 0;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  pointer-events: none;
}

.home-glow-one {
  top: -140rpx;
  right: -170rpx;
  background: rgba(156, 214, 197, 0.22);
}

.home-glow-two {
  bottom: 120rpx;
  left: -240rpx;
  background: rgba(211, 225, 216, 0.28);
}

.home-hero,
.home-launch-section,
.home-journey,
.status,
.warning,
.error,
.retry-button {
  position: relative;
  z-index: 1;
}

.home-hero {
  position: relative;
  padding: 36rpx 34rpx 34rpx;
}

.home-hero-header {
  display: block;
  padding-right: 144rpx;
}

.home-manage {
  position: absolute;
  top: 20rpx;
  right: 34rpx;
  z-index: 1;
  flex: 0 0 auto;
  padding-right: 0;
  padding-left: 16rpx;
}

.home-manage-hover {
  opacity: 0.72;
}

.home-hero .subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  letter-spacing: -0.5rpx;
  white-space: nowrap;
}

.home-metrics {
  display: flex;
  width: 100%;
  min-width: 0;
  align-items: stretch;
  gap: 28rpx;
  margin-top: 34rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid rgba(189, 203, 197, 0.74);
}

.metric {
  min-width: 0;
}

.metric-resume {
  flex: 1 1 0%;
}

.metric-quota {
  min-width: 150rpx;
  flex: 0 1 190rpx;
  border-left: 1rpx solid rgba(189, 203, 197, 0.74);
  padding-left: 28rpx;
}

.metric-value {
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metric-label {
  margin-bottom: 6rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.home-launch-section {
  width: 100%;
  align-self: stretch;
  margin-top: 34rpx;
}

.primary-launch {
  display: flex;
  width: 100%;
  max-width: 100%;
  align-self: stretch;
  min-height: 156rpx;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin: 0;
  padding: 30rpx;
  border: 0;
  border-radius: 28rpx;
  background: var(--color-primary);
  color: #ffffff;
  text-align: left;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.25), 0 16rpx 34rpx rgba(29, 95, 87, 0.18);
  transition: transform 120ms ease, opacity 120ms ease;
}

.primary-launch:active {
  opacity: 0.86;
  transform: scale(0.985);
}

.primary-launch[disabled] {
  background: #d9dedb;
  color: #6f7d80;
}

.launch-copy {
  min-width: 0;
  flex: 1;
}

.launch-title {
  font-size: 32rpx;
  font-weight: 700;
}

.launch-description {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.86;
}

.launch-arrow {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 72rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.42);
  border-radius: 50%;
  font-size: 48rpx;
  line-height: 1;
}

.launch-warning,
.retry-button {
  margin-top: 20rpx;
}

.home-journey {
  margin-top: 32rpx;
  padding: 28rpx 30rpx 10rpx;
}

.journey-heading {
  color: var(--color-text);
  font-size: 27rpx;
  font-weight: 650;
}

.journey-grid {
  display: flex;
  width: 100%;
  min-width: 0;
  flex-direction: column;
  margin-top: 12rpx;
}

.journey-item {
  display: flex;
  width: 100%;
  min-width: 0;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(189, 203, 197, 0.56);
}

.journey-item:last-child {
  border-bottom: 0;
}

.journey-index {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary-strong);
  font-size: 20rpx;
  font-weight: 700;
}

.journey-copy {
  min-width: 0;
  flex: 1 1 0%;
}

.fact-title {
  font-size: 26rpx;
  font-weight: 650;
}

.journey-item .muted {
  margin-top: 2rpx;
  font-size: 23rpx;
  line-height: 1.45;
}
