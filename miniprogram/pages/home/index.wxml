<view class="page">
  <view class="page-header">
    <view class="title">今天投哪份？</view>
    <view class="subtitle">选好岗位信息，生成一段有事实支撑的开场白。</view>
  </view>

  <view wx:if="{{loading}}" class="status">加载中，正在同步你的资料。</view>
  <view wx:if="{{errorMessage}}" class="error">{{errorMessage}}</view>
  <view wx:if="{{weakNetwork}}" class="warning">网络连接不稳定，已保留当前页面。你可以重新尝试。</view>

  <view class="home-summary">
    <view class="summary-item">
      <view class="summary-label">当前简历</view>
      <view class="summary-value summary-value-name">{{defaultResumeName}}</view>
      <button class="text-action" bindtap="openResumes">管理简历</button>
    </view>
    <view class="summary-divider"></view>
    <view class="summary-item summary-item-quota">
      <view class="summary-label">今日剩余</view>
      <view class="quota-line"><text class="quota-number">{{remainingQuota}}</text><text class="quota-unit">次</text></view>
      <view class="summary-help">北京时间次日恢复</view>
    </view>
  </view>

  <view class="home-action">
    <view class="section-title">提交岗位信息</view>
    <view class="muted">支持一次添加最多 5 张截图，也可以粘贴岗位文字。</view>
    <button class="button" disabled="{{!generationEnabled}}" bindtap="openGeneration">{{primaryActionLabel}}</button>
    <view wx:if="{{pauseTitle}}" class="warning">
      <view class="message-title">{{pauseTitle}}</view>
      <view>{{pauseDescription}}</view>
    </view>
  </view>
  <button wx:if="{{errorMessage}}" class="button button-secondary" bindtap="loadHome">重新尝试</button>
</view>
