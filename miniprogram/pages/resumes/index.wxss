.resumes-page {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
}

.resume-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.resume-card {
  display: flex;
  min-height: 144rpx;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 22rpx 26rpx 28rpx;
}

.resume-main {
  min-width: 0;
  flex: 1;
}

.resume-name {
  overflow: hidden;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.resume-title-row {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12rpx;
}

.resume-title-row .pill {
  flex: 0 0 auto;
}

.resume-more {
  display: flex;
  width: 88rpx;
  min-height: 88rpx;
  flex: 0 0 88rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 20rpx;
  background: rgba(222, 236, 231, 0.68);
  color: var(--color-primary-strong);
  font-size: 34rpx;
  letter-spacing: 2rpx;
}

.resume-more:active {
  opacity: 0.72;
}

.empty-resume .muted,
.resume-note .field-help {
  margin-top: 8rpx;
}

.resume-note {
  margin-top: 36rpx;
  padding: 0 4rpx;
}

.resume-add-action {
  margin-top: 36rpx;
}

.retry-button {
  margin-top: 20rpx;
}
