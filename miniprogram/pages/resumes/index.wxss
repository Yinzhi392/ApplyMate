.resume-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.resume-item {
  padding: 28rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx;
  background: var(--color-surface);
}

.resume-name {
  font-size: 31rpx;
  font-weight: 650;
}

.resume-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 22rpx;
}

.resume-actions .button {
  font-size: 26rpx;
}
