<view class="page">
  <view class="page-header">
    <view class="pill">受保护入口</view>
    <view class="title">管理员工具</view>
    <view class="subtitle">权限由服务端 OpenID 白名单判断，客户端不能声明管理员身份。</view>
  </view>

  <view wx:if="{{loading}}" class="status">加载中，正在校验管理员权限。</view>
  <view wx:if="{{errorMessage}}" class="error">{{errorMessage}}</view>

  <view wx:if="{{authorized}}" class="stats-grid">
    <view class="stat-item">
      <view class="stat-value">{{userTotal}}</view>
      <view class="stat-label">用户</view>
    </view>
    <view class="stat-item">
      <view class="stat-value">{{usageSucceeded}}</view>
      <view class="stat-label">今日调用</view>
    </view>
    <view class="stat-item">
      <view class="stat-value">{{inviteActive}}</view>
      <view class="stat-label">有效邀请码</view>
    </view>
  </view>

  <view wx:if="{{authorized}}" class="admin-section">
    <view class="section-title">邀请码</view>
    <view class="admin-form">
      <button class="button" bindtap="createInvite">创建邀请码</button>
      <view wx:if="{{inviteCode}}" class="status">邀请码：{{inviteCode}}</view>
      <button wx:if="{{inviteId}}" class="button button-secondary" bindtap="revokeInvite">撤销当前邀请码</button>
    </view>
  </view>

  <view wx:if="{{authorized}}" class="admin-section">
    <view class="section-title">用户与当日额度</view>
    <view class="admin-form">
      <input class="input" value="{{targetUserId}}" placeholder="目标用户 ID" bindinput="updateTargetUserId" />
      <input class="input" type="number" value="{{quotaIncrease}}" placeholder="增加次数" bindinput="updateQuota" />
      <input class="input" value="{{reason}}" placeholder="必填审计原因" bindinput="updateReason" />
      <button class="button button-secondary" bindtap="increaseQuota">增加当日临时次数</button>
      <view class="admin-actions">
        <button class="button button-quiet" data-enabled="true" bindtap="setUserEnabled">启用用户</button>
        <button class="button button-danger-secondary" data-enabled="false" bindtap="setUserEnabled">停用用户</button>
      </view>
    </view>
  </view>

  <view class="sticky-action">
    <button wx:if="{{authorized}}" class="button button-secondary" bindtap="loadAdmin">刷新统计</button>
    <button wx:if="{{errorMessage}}" class="button button-secondary" bindtap="loadAdmin">重新尝试</button>
  </view>
</view>
