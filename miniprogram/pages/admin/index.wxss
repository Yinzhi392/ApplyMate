.stats-grid {
  display: flex;
  width: 100%;
  min-width: 0;
  align-items: stretch;
  gap: 20rpx;
  padding: 26rpx 18rpx;
}

.stat-item {
  min-width: 0;
  flex: 1 1 0%;
  padding: 4rpx 8rpx;
  text-align: center;
}

.stat-item + .stat-item {
  border-left: 1rpx solid var(--color-border);
}

.stat-value {
  font-size: 38rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 5rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.metric-list {
  padding: 0 24rpx;
}

.metric-row {
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 88rpx;
  align-items: center;
  gap: 16rpx;
}

.metric-row + .metric-row {
  border-top: 1rpx solid var(--color-border);
}

.metric-label {
  min-width: 0;
  flex: 1 1 auto;
  font-weight: 600;
}

.metric-counts {
  flex: 0 0 auto;
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.metric-value {
  width: 88rpx;
  flex: 0 0 88rpx;
  color: var(--color-primary);
  font-weight: 700;
  text-align: right;
}

.menu-action {
  flex-shrink: 0;
  color: var(--color-primary);
  font-size: 25rpx;
}

.invite-result {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-left: 6rpx solid var(--color-primary);
  background: var(--color-surface);
}

.invite-code {
  margin: 8rpx 0 20rpx;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.quota-row {
  display: flex;
  width: 100%;
  min-width: 0;
  align-items: end;
  gap: 18rpx;
  margin-top: 32rpx;
}

.admin-form {
  padding: 28rpx;
}

.quota-field {
  min-width: 150rpx;
  flex: 0 1 180rpx;
}

.quota-action {
  width: auto;
  min-width: 0;
  flex: 1 1 0%;
  padding-right: 16rpx;
  padding-left: 16rpx;
}

.admin-actions {
  margin-top: 32rpx;
}

.danger-row {
  color: var(--color-danger);
}

.danger-action {
  flex-shrink: 0;
  color: var(--color-danger);
  font-size: 25rpx;
}
