.records-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.filter-bar {
  display: flex;
  width: 100%;
  min-width: 0;
  padding: 6rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 18rpx;
  background: rgba(233, 239, 235, 0.9);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.filter-option {
  width: auto;
  min-width: 0;
  min-height: 88rpx;
  flex: 1 1 0%;
  margin: 0;
  border-radius: 12rpx;
  background: transparent;
  color: var(--color-text-secondary);
  font-size: 25rpx;
}

.filter-option.is-active {
  background: var(--color-glass-surface-strong);
  color: var(--color-primary-strong);
  font-weight: 650;
  box-shadow: inset 0 1rpx 0 #ffffff, 0 6rpx 16rpx rgba(36, 82, 75, 0.08);
}

.record-list {
  overflow: hidden;
  padding: 0 24rpx;
}

.record-row {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.record-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.record-copy {
  min-width: 0;
  flex: 1;
}

.record-title {
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pill-neutral {
  background: var(--color-surface-muted);
  color: var(--color-text-secondary);
}

.record-memo {
  margin-top: 16rpx;
  color: var(--color-text-secondary);
  font-size: 25rpx;
  line-height: 1.6;
}

.record-link {
  margin-top: 18rpx;
  color: var(--color-primary);
  font-size: 24rpx;
}

.empty .muted {
  margin-top: 8rpx;
}

.retry-button {
  margin-top: 20rpx;
}
