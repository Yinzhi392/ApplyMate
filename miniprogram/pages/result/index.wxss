.result-header {
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.greeting-surface {
  overflow: hidden;
  padding: 22rpx 24rpx 24rpx;
}

.greeting-editor {
  min-height: 500rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  font-size: 29rpx;
  line-height: 1.85;
}

.editor-meta {
  display: flex;
  min-width: 0;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.ai-label-note,
.warning-item {
  margin-top: 16rpx;
}

.secondary-action-row,
.rating-actions {
  margin-top: 16rpx;
}

.disclosure-list {
  border-top: 1rpx solid var(--color-border);
}

.disclosure {
  border-bottom: 1rpx solid var(--color-border);
}

.disclosure-trigger {
  display: flex;
  width: 100%;
  min-height: 96rpx;
  align-items: center;
  justify-content: space-between;
  margin: 0;
  padding: 0;
  background: transparent;
  color: var(--color-text);
  font-weight: 650;
  text-align: left;
}

.disclosure-state {
  color: var(--color-primary);
  font-size: 24rpx;
}

.disclosure-content {
  padding: 4rpx 0 28rpx;
}

.evidence-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.evidence-claim {
  margin-bottom: 8rpx;
  font-weight: 650;
}

.evidence-empty {
  margin-top: 12rpx;
}

.secondary-actions {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.secondary-textarea {
  min-height: 160rpx;
}

.rating-button {
  width: auto;
  min-width: 0;
  max-width: 100%;
  min-height: 88rpx;
  flex: 1 1 0%;
  margin: 0;
  border: 1rpx solid var(--color-border-strong);
  border-radius: 14rpx;
  background: transparent;
  color: var(--color-text-secondary);
  font-size: 25rpx;
}

.rating-button.is-active {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
  color: var(--color-primary-strong);
}

.retry-button {
  margin-top: 24rpx;
}

.result-exit {
  padding: 28rpx;
}

.result-exit-copy .field-help {
  margin-top: 8rpx;
}

.result-exit-actions {
  margin-top: 24rpx;
}

.result-next-button,
.result-home-button {
  min-height: 96rpx;
}
