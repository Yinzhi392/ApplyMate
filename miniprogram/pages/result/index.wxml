<view class="page result-page">
  <view class="page-header result-header">
    <view class="page-header-copy">
      <view class="title">专属开场白</view>
      <view class="subtitle">{{companyDisplayName}} · {{jobTitle}}，内容已通过事实来源检查。</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="status">加载中，正在整理结果。</view>
  <view wx:if="{{errorMessage}}" class="error">{{errorMessage}}</view>

  <block wx:if="{{!loading}}">
    <view class="greeting-surface glass-surface">
      <textarea class="textarea greeting-editor" value="{{greetingBody}}" maxlength="1000" bindinput="updateBody" />
      <view class="editor-meta"><text>{{visibleCharacters}} 个可见字符</text><text>建议约 300 字</text></view>
      <view wx:for="{{manualWarnings}}" wx:key="message" class="warning warning-item">{{item.message}}</view>
      <view class="ai-disclosure surface-panel">
        <view class="ai-label-note">AI生成内容，请核对真实性</view>
        <view class="field-help generation-disclosure-message">{{generationDisclosureMessage}}</view>
        <view wx:if="{{generationDisclosureDetails}}" class="field-help generation-disclosure-details">{{generationDisclosureDetails}}</view>
      </view>
    </view>

    <view class="section primary-actions">
      <button class="button" bindtap="copyBody">复制开场白</button>
      <button class="button button-secondary" bindtap="saveBody">保存修改</button>
    </view>

    <view class="section disclosure-list">
      <view class="disclosure">
        <button class="disclosure-trigger" bindtap="toggleSecondary">
          <text>投递状态、备忘与反馈</text>
          <text class="disclosure-state">{{secondaryExpanded ? '收起' : '展开'}}</text>
        </button>
        <view wx:if="{{secondaryExpanded}}" class="disclosure-content secondary-actions">
          <view class="field-group">
            <label class="field-label">投递备忘</label>
            <textarea class="textarea secondary-textarea" value="{{memo}}" maxlength="500" placeholder="例如：8 月 7 日已发送" bindinput="updateMemo" />
            <button class="button button-secondary" bindtap="saveMemo">保存备忘</button>
          </view>
          <button class="button button-secondary" bindtap="markApplied">{{status === 'applied' ? '已投递' : '标记为已投递'}}</button>
          <view class="field-group">
            <view class="field-label">这次结果怎么样？</view>
            <view class="rating-actions action-row">
              <button class="rating-button {{rating === 'satisfied' ? 'is-active' : ''}}" data-rating="satisfied" bindtap="setRating">满意</button>
              <button class="rating-button {{rating === 'needs_improvement' ? 'is-active' : ''}}" data-rating="needs_improvement" bindtap="setRating">需改进</button>
            </view>
            <textarea class="textarea secondary-textarea" value="{{feedbackNote}}" maxlength="500" placeholder="可选说明，最多 500 字" bindinput="updateFeedbackNote" />
            <button class="button button-secondary" disabled="{{!rating}}" bindtap="submitFeedback">提交反馈</button>
          </view>
        </view>
      </view>
    </view>

    <view class="section result-exit glass-surface">
      <view class="result-exit-copy">
        <view class="section-title">准备投下一个岗位？</view>
        <view class="field-help">当前修改会先保存，再进入一份全新的岗位草稿。</view>
      </view>
      <view class="result-exit-actions action-row action-row-weighted">
        <button class="button result-next-button" disabled="{{leaving}}" bindtap="continueNextJob">继续投下一个岗位</button>
        <button class="button button-secondary result-home-button" disabled="{{leaving}}" bindtap="returnHome">返回首页</button>
      </view>
    </view>
  </block>

  <button wx:if="{{errorMessage}}" class="button button-secondary retry-button" bindtap="retryLoadResult">重新尝试</button>
</view>
