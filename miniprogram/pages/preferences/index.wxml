<view class="page page-with-fixed-action">
  <view class="page-header preferences-header">
    <view class="page-header-copy">
      <view class="title">求职偏好</view>
      <view class="subtitle">这些内容也会成为可追溯事实。</view>
    </view>
    <button class="text-action" disabled="{{loading}}" bindtap="clear">清空</button>
  </view>

  <view class="field-group preference-editor glass-surface">
    <label class="field-label">补充你的长期偏好</label>
    <textarea class="textarea" value="{{text}}" maxlength="520" placeholder-class="textarea-placeholder" placeholder="例如：希望远程。可以立即到岗。每周工作 4 天。" bindinput="updateText" />
    <view class="counter">{{visibleCharacters}} / 500 字</view>
  </view>
  <view wx:if="{{message}}" class="error section">{{message}}</view>
  <view wx:if="{{errorMessage}}" class="error section">{{errorMessage}}</view>

  <view class="section preference-facts">
    <view class="section-heading"><view class="section-title">将保存为 {{segments.length}} 项事实</view></view>
    <view wx:if="{{segments.length}}" class="list-group segment-list">
      <view wx:for="{{segments}}" wx:key="*this" class="segment-row">
        <view>{{item}}</view>
      </view>
    </view>
    <view wx:else class="quiet-panel">按句号、分号或换行自动拆分；无需逐项选择。</view>
  </view>

  <view class="fixed-action">
    <button class="button" disabled="{{loading || !valid}}" bindtap="save">保存偏好</button>
  </view>
</view>
