.preferences-header {
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.preference-editor .textarea {
  min-height: 360rpx;
}

.preference-editor {
  padding: 28rpx;
}

.preference-facts {
  padding: 0 2rpx;
}

.segment-row {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.segment-row:last-child {
  border-bottom: 0;
}
