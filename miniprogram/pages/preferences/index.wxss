.preference-editor {
  margin-bottom: 36rpx;
}

.preference-editor .textarea {
  min-height: 360rpx;
}

.segment-preview {
  margin-top: 28rpx;
}

.segment-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 14rpx;
}

.segment-item {
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary-strong);
  font-size: 26rpx;
}
