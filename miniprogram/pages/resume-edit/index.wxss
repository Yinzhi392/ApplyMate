.review-header {
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.review-guidance {
  padding: 24rpx 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-left: 6rpx solid var(--color-primary);
  border-radius: 18rpx;
  background: rgba(222, 236, 231, 0.72);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.review-guidance .muted {
  margin-top: 8rpx;
}

.profile-name-section,
.review-block {
  padding: 28rpx;
}

.strength-list,
.weight-list,
.review-list {
  border-top: 1rpx solid var(--color-border);
}

.strength-row,
.weight-row,
.review-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.strength-row:last-child,
.weight-row:last-child,
.review-row:last-child {
  border-bottom: 0;
}

.strength-rank {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-primary-soft);
  color: var(--color-primary-strong);
  font-size: 23rpx;
  font-weight: 700;
}

.strength-copy,
.weight-copy {
  min-width: 0;
  flex: 1;
}

.strength-label,
.review-text {
  font-weight: 650;
}

.strength-score,
.weight-value {
  color: var(--color-primary-strong);
  font-weight: 700;
}

.weight-note {
  margin-top: 16rpx;
}

.weight-row {
  align-items: center;
}

.review-row {
  display: block;
}

.needs-review {
  margin: 14rpx 0;
  padding: 20rpx;
  border: 1rpx solid rgba(218, 183, 137, 0.5);
  border-radius: 16rpx;
  background: var(--color-warning-soft);
}

.review-label {
  margin-bottom: 8rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.review-actions {
  display: flex;
  width: 100%;
  min-width: 0;
  align-items: stretch;
  flex-wrap: nowrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.mini-action {
  display: flex;
  width: 0;
  min-width: 0;
  max-width: 100%;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  flex: 1 1 0%;
  margin: 0;
  padding: 10rpx 12rpx;
  border: 1rpx solid var(--color-border-strong);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.82);
  color: var(--color-primary-strong);
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.96), 0 6rpx 14rpx rgba(36, 82, 75, 0.07);
}

.correct-action {
  border-color: rgba(38, 118, 108, 0.24);
  background: var(--color-primary-soft);
}

.edit-action {
  border-color: rgba(38, 118, 108, 0.28);
}

.delete-action {
  border-color: rgba(146, 72, 63, 0.2);
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.mini-action:active {
  opacity: 0.82;
  transform: scale(0.98);
}

.fact-editor {
  min-height: 140rpx;
}
