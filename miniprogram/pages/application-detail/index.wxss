.detail-header {
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.detail-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 26rpx;
}

.greeting-snapshot {
  padding: 26rpx;
  border-left: 6rpx solid var(--color-primary);
  background: var(--color-glass-surface);
  font-size: 27rpx;
  line-height: 1.8;
}

.snapshot-note {
  margin-top: 12rpx;
}

.source-row {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.source-row:last-child {
  border-bottom: 0;
}

.source-dot {
  width: 16rpx;
  height: 16rpx;
  flex: 0 0 16rpx;
  border-radius: 50%;
  background: var(--color-primary);
}

.detail-memo {
  line-height: 1.7;
}

.detail-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.retry-button {
  margin-top: 24rpx;
}
